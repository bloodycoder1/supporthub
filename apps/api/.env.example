# Copy to .env for local development. Never commit .env.
NODE_ENV=development
PORT=4000
MONGO_URI=mongodb://127.0.0.1:27017/supporthub
REDIS_URL=redis://127.0.0.1:6379
CORS_ORIGIN=http://localhost:3000
LOG_LEVEL=info
# Required from Milestone 2 (auth). Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# JWT_SECRET=
